# Copy to .env.local for local development. NEVER commit real values.
# On your host add these in the project's environment-variable settings.

# Final public URL of THIS site (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Your personal portfolio (linked from the header, About and footer).
